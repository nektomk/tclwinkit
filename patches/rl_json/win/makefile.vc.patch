diff --git a/win/makefile.vc b/win/makefile.vc
index 413b933..a0fa79e 100644
--- a/win/makefile.vc
+++ b/win/makefile.vc
@@ -23,13 +23,36 @@ PRJ_OBJS = \
 	$(TMP_DIR)\json_types.obj \
 	$(TMP_DIR)\dedup.obj \
 	$(TMP_DIR)\api.obj \
-	$(TMP_DIR)\parser.obj
+	$(TMP_DIR)\parser.obj \
+	$(TMP_DIR)\rl_jsonBuildInfo.obj \
+	$(TMP_DIR)\names.obj
 
 PRJ_STUBOBJS = $(TMP_DIR)\rl_jsonStubLib.obj
 
-PRJ_DEFINES = -D_CRT_SECURE_NO_WARNINGS
+PRJ_DEFINES = -D_CRT_SECURE_NO_WARNINGS /Zc:preprocessor \
+	/DENSEMBLE=0 /DDEDUP=1 /DDEBUG=0 /DUNLOAD=0 \
+	/DHAVE_TCL_GETNUMBERFROMOBJ=1 /DTIP445_SHIM=0 /DGETBYTES_SHIM=0 \
+	/DRL_JSON_LIBRARY_PATH_INSTALL="\"\"" \
+	/DRL_JSON_INCLUDE_PATH_INSTALL="\"\"" \
+	/DRL_JSON_PACKAGE_PATH_INSTALL="\"\"" \
+	/DRL_JSON_LIBRARY="\"librl_json0178\"" \
+	/DRL_JSON_STUBLIB="\"librl_json\"" \
+	/DRL_JSON_HEADER="\"rl_json.h\""
+
+PRJ_INCLUDES = -I"..\teabase"
 
 !include "$(_RULESDIR)\targets.vc"
 
+# teabase source (submodule dir, not in standard VPATH of targets.vc)
+$(TMP_DIR)\names.obj: ..\teabase\names.c
+	$(cc32) $(cflags) $(INCLUDES) $(PRJ_DEFINES) /DBUILD_$(PROJECT) -Fo$(TMP_DIR)\names.obj ..\teabase\names.c
+
+# rl_jsonBuildInfo.c stringifies RL_JSON_VERSION_UUID out of generic\rl_jsonUuid.h.
+# Upstream generates that header from autoconf and declares the dependency
+# (Makefile.in: "rl_jsonBuildInfo.$(OBJEXT): rl_jsonUuid.h"); this nmakefile has
+# neither the rule nor the dependency, so nmake reuses a stale object and the
+# shipped library keeps whatever UUID the previous build wrote. Declared here.
+$(TMP_DIR)\rl_jsonBuildInfo.obj: ..\generic\rl_jsonUuid.h
+
 pkgindex: default-pkgindex-tea
 install: default-install-docs-html
