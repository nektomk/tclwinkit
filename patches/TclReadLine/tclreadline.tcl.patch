+
+# B4/safe-kit: TARGET-aware wrappers. With TARGET empty each one behaves as
+# the code it replaces did, so the normal kit is untouched; with TARGET naming
+# a safe child the lookup or the eval happens there instead.
+proc TclReadLine::targetEval {script} {
+    variable TARGET
+    variable RUN_LOCAL
+    if {$TARGET eq "" || $RUN_LOCAL} { return [uplevel #0 $script] }
+    return [interp eval $TARGET $script]
+}
+proc TclReadLine::targetInfoVars {pattern} {
+    variable TARGET
+    if {$TARGET eq ""} { return [uplevel #0 [list info vars $pattern]] }
+    return [interp eval $TARGET [list info vars $pattern]]
+}
+proc TclReadLine::targetArrayNames {arrayvar pattern} {
+    variable TARGET
+    if {$TARGET eq ""} { return [uplevel #0 [list array names $arrayvar $pattern]] }
+    return [interp eval $TARGET [list array names $arrayvar $pattern]]
+}
+proc TclReadLine::targetInfoCommands {pattern} {
+    variable TARGET
+    if {$TARGET eq ""} {
+        if {$pattern eq "*"} { return [info commands] }
+        return [info commands $pattern]
+    }
+    if {$pattern eq "*"} { return [interp eval $TARGET {info commands}] }
+    return [interp eval $TARGET [list info commands $pattern]]
+}
+proc TclReadLine::targetArrayExists {arrayvar} {
+    variable TARGET
+    if {$TARGET eq ""} { return [uplevel #0 [list array exists $arrayvar]] }
+    return [interp eval $TARGET [list array exists $arrayvar]]
