diff --git a/win/makefile.vc b/win/makefile.vc
index 9e38c11..846ae0a 100644
--- a/win/makefile.vc
+++ b/win/makefile.vc
@@ -68,7 +68,7 @@ PRJ_HEADERS = \
 # In principle, we don't need the TK source directory, and an installed
 # TK should suffice. But that needs additional machinery not implemented
 # yet.
-!if [echo TK_DIR = \> nmakehlp.out] \
+!if [echo TK_DIR = \>> nmakehlp.out] \
    || [nmakehlp -L generic\tk.h >> nmakehlp.out]
 !error Could not locate TK source directory.
 !endif
@@ -80,7 +80,7 @@ PRJ_HEADERS = \
 !error Could not retrieve ITCL version.
 !endif
 # Get the TK version from its configure.ac
-!if [echo TK_DOTVERSION = \> versions.vc] \
+!if [echo TK_DOTVERSION = \>> versions.vc] \
    && [nmakehlp -V "$(TK_DIR)\configure.ac" tk >> versions.vc]
 !error Could not retrieve TK version.
 !endif
@@ -135,12 +135,18 @@ $(OUT_DIR)\pkgIndex.tcl: $(ROOT)\pkgIndex.tcl.in
 @PKG_LIB_FILE9@       $(PRJLIBNAME9)
 <<
 
+# Upstream derives this from `git rev-parse HEAD` run inside $(ROOT), which
+# for us is a directory INSIDE our own checkout, so it would report our
+# commit -- a hash that exists in no itk repository, and a different value on
+# every rebuild. We are building from a tarball, which is exactly the case
+# upstream's own fallback handles: no git, no svn, value "unknown". Stated
+# literally so the two toolchains agree and the artifact stops carrying
+# builder state. See docs/SOURCES.md ("manifest.uuid: what it actually means").
 $(ROOT)\manifest.uuid:
-   copy $(WIN_DIR)\gitmanifest.in $(ROOT)\manifest.uuid
-   git rev-parse HEAD >>$(ROOT)\manifest.uuid
+   echo unknown>$(ROOT)\manifest.uuid
 
 $(TMP_DIR)\itkUuid.h:	$(ROOT)\manifest.uuid
-	copy $(WIN_DIR)\itkUuid.h.in+$(ROOT)\manifest.uuid $(TMP_DIR)\itkUuid.h
+	copy /b $(WIN_DIR)\itkUuid.h.in+$(ROOT)\manifest.uuid $(TMP_DIR)\itkUuid.h
 
 test: setup $(PROJECT)
 	@echo testing itk
