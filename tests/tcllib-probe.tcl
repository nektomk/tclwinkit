# tcllib-probe.tcl -- every tcllib/tklib package in the kit must still load.
#
# The kit staging strips test suites, manuals, benchmarks and sample data out
# of the tcllib/tklib trees (scripts/kit-prune.ps1). This probe is the
# regression guard for that: it enumerates the "package ifneeded" offers of
# every pkgIndex.tcl in the tree and requires each package, so a module that
# lost a runtime catalog, icon or message file at staging time fails here.
#
#   kit exe     tests/tcllib-probe.tcl            # probe the zipfs image
#   stock tclsh tests/tcllib-probe.tcl -baseline  # probe the source trees
#
# Not every failure is a staging bug: tcllib references packages a kit never
# ships (tdom, tls, critcl, Trf, xml, nx), sources a file that does not exist
# upstream either (nettool/nextool.tcl), and offers duplicate versions of some
# names. So -baseline records the full failure set of the UNPRUNED source
# trees into tests/tcllib-probe.baseline.txt, and a kit run reports NEW for
# anything that is not in that snapshot. Baseline itself therefore always
# passes, and a pruned runtime file cannot hide behind an upstream complaint.
#
# Exit status: 0 = no new failures, 1 = at least one.

set here [file dirname [file normalize [info script]]]
set Snapshot [file join $here tcllib-probe.baseline.txt]

set baseline [expr {"-baseline" in $argv}]

set SrcTrees {
    tcllib2.0 C:/src/winkit/build/common/tcllib-2.0/modules
    tklib0.9  C:/src/winkit/build/common/tklib-0.9/modules
}

if {$baseline} {
    set roots {}
    foreach {leaf dir} $SrcTrees {
	if {[file isdirectory $dir]} { lappend roots [file normalize $dir] }
    }
    if {$roots eq {}} {
	puts "PROBE FAIL: source trees absent (run the build first)"
	exit 1
    }
    lappend ::auto_path {*}$roots
} else {
    set roots {}
    foreach p $::auto_path {
	foreach {leaf dir} $SrcTrees {
	    set d [file join $p $leaf]
	    if {[file isdirectory $d]} { lappend roots [file normalize $d] }
	}
    }
    if {$roots eq {}} {
	puts "PROBE FAIL: no tcllib/tklib in the image (auto_path: [join $::auto_path {, }])"
	exit 1
    }
}

# ------------------------------------------------------- collect the offers ---
# package name -> highest version offered by the trees
array set BEST {}
foreach root $roots {
    set idxs {}
    foreach pat {*/pkgIndex.tcl */*/pkgIndex.tcl */*/*/pkgIndex.tcl} {
	foreach g [glob -nocomplain -directory $root $pat] { lappend idxs $g }
    }
    foreach f [lsort -unique $idxs] {
	if {[catch {
	    set ch [open $f r]
	    set txt [read $ch]
	    close $ch
	} err]} {
	    puts "SKIP  unreadable pkgIndex $f: $err"
	    continue
	}
	foreach line [split $txt "\n"] {
	    if {![regexp {^\s*package\s+ifneeded\s+(\S+)\s+(\S+)} $line -> name ver]} {
		continue
	    }
	    if {![info exists BEST($name)] || [package vcompare $ver $BEST($name)] > 0} {
		set BEST($name) $ver
	    }
	}
    }
}

# ------------------------------------------------------------------- probe ---
set loaded 0
set fails {}
foreach name [lsort [array names BEST]] {
    set ver $BEST($name)
    if {[catch {package require $name $ver} err]} {
	lappend fails [list $name $ver [string map [list "\n" " " "\r" "" "\t" " "] $err]]
    } else {
	incr loaded
    }
}

if {$baseline} {
    set out [list "# tcllib/tklib probe baseline -- failures of the UNPRUNED"]
    lappend out "# source trees, generated by: tests/tcllib-probe.tcl -baseline"
    lappend out "# format: <package> <version> <first line of the error>"
    lappend out "# packages: [llength [array names BEST]], loaded: $loaded"
    foreach f $fails {
	lassign $f name ver err
	# tab-separated: error texts contain quotes followed by colons, which
	# Tcl list parsing would reject
	lappend out "$name\t$ver\t$err"
    }
    set ch [open $Snapshot w]
    fconfigure $ch -encoding utf-8
    puts $ch [join $out "\n"]
    close $ch
    puts "tcllib/tklib baseline: [llength [array names BEST]] offered, $loaded loaded,\
 [llength $fails] failures -> $Snapshot"
    puts "BASELINE OK"
    exit 0
}

# ------------------------------------------------------------ compare with ---
if {![file exists $Snapshot]} {
    puts "PROBE FAIL: no snapshot at $Snapshot"
    puts "            generate it once with a stock tclsh:"
    puts "            tclsh90s.exe tests\\tcllib-probe.tcl -baseline"
    exit 1
}
set known [list]
set ch [open $Snapshot r]
fconfigure $ch -encoding utf-8
foreach line [split [read $ch] "\n"] {
    if {$line eq {} || [string match {#*} $line]} { continue }
    lappend known [lindex [split $line "\t"] 0]
}
close $ch

set excused 0
set news {}
foreach f $fails {
    lassign $f name ver err
    if {$name in $known} {
	incr excused
    } else {
	lappend news "$name $ver: $err"
    }
}

set offered [expr {$loaded + [llength $fails]}]
puts "tcllib/tklib probe: $offered offered, $loaded loaded, \
[llength $fails] failed ($excused known-upstream, [llength $news] NEW) \
(roots: [join $roots { ; }])"
foreach n $news { puts "  NEW FAILURE  $n" }
if {[llength $news]} {
    puts "PROBE FAIL"
    exit 1
}
puts "PROBE OK"
exit 0
